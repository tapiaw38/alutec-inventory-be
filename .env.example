APP_NAME=alutec-inventory-be
GIN_MODE=debug
PORT=8080

DATABASE_URL=postgres://postgres:postgres@alutec-inventory-postgres-db:5432/alutec-inventory-db?sslmode=disable

FRONTEND_URL=http://localhost:9000
# Single login accepted by the API (placeholder until real user accounts).
# AUTH_SECRET signs session tokens: change it and every session is revoked.
AUTH_EMAIL=admin@alutec.com.ar
AUTH_PASSWORD=change-me
AUTH_SECRET=change-me-to-a-long-random-string
